<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="Xolmis Test"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="lazmapviewer_bgra"/>
      </Item>
      <Item>
        <PackageName Value="TAChartBgra"/>
      </Item>
      <Item>
        <PackageName Value="lr_pdfexport"/>
      </Item>
      <Item>
        <PackageName Value="lazreportpdfexport"/>
      </Item>
      <Item>
        <PackageName Value="lazreport"/>
      </Item>
      <Item>
        <PackageName Value="TAChartLazarusPkg"/>
      </Item>
      <Item>
        <PackageName Value="ibcontrols"/>
      </Item>
      <Item>
        <PackageName Value="atflatcontrols_package"/>
      </Item>
      <Item>
        <PackageName Value="fpexif_pkg"/>
      </Item>
      <Item>
        <PackageName Value="HashLib4PascalPackage"/>
      </Item>
      <Item>
        <PackageName Value="cbs_pack"/>
      </Item>
      <Item>
        <PackageName Value="Pixie.Package.Lazarus"/>
      </Item>
      <Item>
        <PackageName Value="laz.virtualtreeview_package"/>
      </Item>
      <Item>
        <PackageName Value="virtualdbgrid_package"/>
      </Item>
      <Item>
        <PackageName Value="bgracontrols"/>
      </Item>
      <Item>
        <PackageName Value="lazMapViewerPkg"/>
      </Item>
      <Item>
        <PackageName Value="uniqueinstance_package"/>
      </Item>
      <Item>
        <PackageName Value="laz_fpspreadsheetexport_visual"/>
      </Item>
      <Item>
        <PackageName Value="fpcunittestrunner"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="xolmis_test.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="test_utils_math.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="test_utils_math"/>
      </Unit>
      <Unit>
        <Filename Value="test_utils_taxonomy.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="test_utils_taxonomy"/>
      </Unit>
      <Unit>
        <Filename Value="test_io_core.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="test_io_core"/>
      </Unit>
      <Unit>
        <Filename Value="test_data_setparam.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="test_data_setparam"/>
      </Unit>
      <Unit>
        <Filename Value="test_models_xmobile.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="test_models_xmobile"/>
      </Unit>
      <Unit>
        <Filename Value="test_providers_institutions.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="test_providers_institutions"/>
      </Unit>
      <Unit>
        <Filename Value="test_utils_conversions.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="test_utils_gis.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
    <Debugger>
      <StoreDebuggerClassConfInSession Value="True"/>
    </Debugger>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="xolmis_test"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="..\..\lib\x86_64-win64"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
