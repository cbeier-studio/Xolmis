    BeforePost = qAudiosBeforePost
    Database = DMM.sqlCon
    Transaction = DMM.sqlTrans
    SQL.Strings = (
      'SELECT snd.*,'
      '  z.scientific_name AS taxon_name,'
      '  i.full_name AS individual_name,'
      '  sp.full_name AS specimen_name,'
      '  s.full_name AS sighting_name,'
      '  g.site_name AS locality_name,'
      '  p.full_name AS author_name'
      'FROM audio_library AS snd'
      'LEFT JOIN zoo_taxa AS z ON snd.taxon_id = z.taxon_id'
      'LEFT JOIN individuals AS i ON snd.individual_id = i.individual_id'
      'LEFT JOIN gazetteer AS g ON snd.locality_id = g.site_id'
      'LEFT JOIN people AS p ON snd.author_id = p.person_id'
      'LEFT JOIN specimens AS sp ON snd.specimen_id = sp.specimen_id'
      'LEFT JOIN sightings AS s ON snd.sighting_id = s.sighting_id'
    )
    InsertSQL.Strings = (
      'INSERT INTO audio_library ('
      '  full_name,'
      '  taxon_id,'
      '  individual_id,'
      '  specimen_id,'
      '  sighting_id,'
      '  audio_type,'
      '  locality_id,'
      '  recording_date,'
      '  recording_time,'
      '  author_id,'
      '  longitude,'
      '  latitude,'
