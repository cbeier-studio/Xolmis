      '  :active_status)'
    )
    UpdateSQL.Strings = (
      'UPDATE audio_library SET'
      '  full_name = :full_name,'
      '  taxon_id = :taxon_id,'
      '  individual_id = :individual_id,'
      '  specimen_id = :specimen_id,'
      '  sighting_id = :sighting_id,'
