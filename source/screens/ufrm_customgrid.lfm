  object qRecycle: TSQLQuery
    FieldDefs = <>
    Database = DMM.sqlCon
    Transaction = DMM.sqlTrans
    SQL.Strings = (
      'SELECT'
      '  %fid AS record_id,'
      '  %fname AS record_name,'
      '  update_date'
      'FROM %ftable'
      'WHERE (active_status = 0)'
      'ORDER BY update_date ASC'
    )
    Params = <>
    Macros = <    
      item
        DataType = ftUnknown
        Name = 'fid'
        ParamType = ptInput
      end    
      item
        DataType = ftUnknown
        Name = 'fname'
        ParamType = ptInput
      end    
      item
        DataType = ftUnknown
        Name = 'ftable'
        ParamType = ptInput
      end>
    MacroCheck = True
    Left = 637
    Top = 64
  end
