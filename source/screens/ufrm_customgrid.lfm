      '  license_year,'
      '  license_uri,'
      '  license_notes,'
      '  license_owner,'
      '  subtitle,'
      '  notes,'
      '  file_path,'
      '  user_inserted,'
      '  insert_date,'
      '  exported_status,'
      '  marked_status,'
      '  active_status)'
      'VALUES ('
      '  :full_name,'
