      '  temperature,'
      '  cloud_cover,'
      '  precipitation,'
      '  relative_humidity,'
      '  wind_speed,'
      '  recording_context,'
      '  playback_used,'
      '  subjects_tally,'
      '  habitat,'
      '  recorder_model,'
      '  mic_model,'
      '  filter_model,'
      '  distance,'
